; Engine configuration file.
; Godot 4.5. Edit with care: autoloads and display settings are part of the build contract
; (see docs/dev/architecture.md).

config_version=5

[application]

config/name="Halo & Horn"
config/description="Idle angel-and-demon gacha RPG"
config/version="0.1.0"
run/main_scene="res://src/main.tscn"
config/features=PackedStringArray("4.5", "GL Compatibility")
boot_splash/bg_color=Color(0.07, 0.055, 0.14, 1)
boot_splash/show_image=false
config/icon="res://icon.svg"

[autoload]

Game="*res://src/core/game.gd"
UI="*res://src/ui/ui.gd"

[display]

window/size/viewport_width=720
window/size/viewport_height=1280
window/size/window_width_override=405
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1

[gui]

common/drop_mouse_on_gui_input_disabled=true

[input_devices]

pointing/emulate_touch_from_mouse=true

[rendering]

renderer/rendering_method="mobile"
renderer/rendering_method.mobile="mobile"
viewport/hdr_2d=true
textures/vram_compression/import_etc2_astc=true
environment/defaults/default_clear_color=Color(0.07, 0.055, 0.14, 1)

[shader_globals]

ui_tilt={
"type": "vec2",
"value": Vector2(0, 0)
}
