#!/usr/bin/env bash
# Run Godot under a shared lock so parallel agents never import/run the project at once.
# GODOT names the binary (default `godot`; on the owner's Windows PC the console build, e.g.
# GODOT=/c/Users/<user>/tools/godot-4.5.1/Godot_v4.5.1-stable_win64_console.exe). Git Bash on Windows
# has no flock, so there it runs unlocked: run one Godot at a time by hand.
G="${GODOT:-godot}"
if command -v flock >/dev/null 2>&1; then
  exec flock /tmp/halo-godot.lock "$G" "$@"
fi
exec "$G" "$@"
