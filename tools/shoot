#!/usr/bin/env bash
# Render one screen to a PNG in a phone-shaped window (needs main.gd --shoot support).
#   tools/shoot <screen> [--res 720x1560] [--out path.png] [any extra game args...]
# Extra game args: --fresh | --rich, --safe-area-sim, --shoot-params='{"hero_id":"seraphiel"}',
#   --shoot-wait=2.0
# Prints the PNG path and any script errors. View the PNG with the Read tool.
cd "$(dirname "$0")/.." || exit 1
screen="$1"; shift
res=720x1560; out="screenshots/${screen}.png"; extra=()
while [ $# -gt 0 ]; do
  case "$1" in
    --res) res="$2"; shift 2;;
    --out) out="$2"; shift 2;;
    *) extra+=("$1"); shift;;
  esac
done
mkdir -p "$(dirname "$out")"
NOISE='ALSA|audio_driver_alsa|All audio drivers failed|audio_server.cpp|init_output_device|^\s*at: (init_output_device|initialize) '
log=$(timeout 120 flock /tmp/halo-godot.lock xvfb-run -a -s "-screen 0 1800x2400x24" \
  godot --path . --rendering-driver opengl3 --resolution "$res" -- \
  --shoot="$screen" --shoot-out="$(realpath -m "$out")" "${extra[@]}" 2>&1 | grep -vE "$NOISE")
echo "$log" | grep -E -A2 "SCRIPT ERROR|Parse Error|ERROR:" | head -30
[ -f "$out" ] && echo "PNG: $out" || { echo "NO PNG WRITTEN"; echo "$log" | tail -15; exit 1; }
