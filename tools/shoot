#!/usr/bin/env bash
# Render one screen to a PNG in a phone-shaped window (needs main.gd --shoot support).
#   tools/shoot <screen> [--res 720x1560] [--out path.png] [--place] [any extra game args...]
# Extra game args: --fresh | --rich (+ --skins: owned heroes wear a skin, --nudity), --safe-area-sim,
#   --shoot-params='{"hero_id":"seraphiel"}',
#   --shoot-wait=2.0, --tilt=-0.45,0.05 (holds the phone tilt: the Legendary foil, the plates), --ldr
# --place (Windows): holds the window 60 s so the owner can drag it where shots should open; the
#   spot is saved in screenshots/.shot_window and every later shot opens there.
# Prints the PNG path and any script errors. View the PNG with the Read tool.
cd "$(dirname "$0")/.." || exit 1
screen="$1"; shift
res=720x1560; out="screenshots/${screen}.png"; extra=(); place=""
while [ $# -gt 0 ]; do
  case "$1" in
    --res) res="$2"; shift 2;;
    --out) out="$2"; shift 2;;
    --place) place=60; shift;;
    *) extra+=("$1"); shift;;
  esac
done
mkdir -p "$(dirname "$out")"
# Never report a stale PNG from an earlier run as this run's result.
rm -f "$out"
NOISE='ALSA|audio_driver_alsa|All audio drivers failed|audio_server.cpp|init_output_device|Condition "status < 0" is true|^\s*at: (init_output_device|initialize) '
# GODOT names the binary (see tools/gd). Without xvfb-run/flock (Git Bash on Windows) the window
# opens where the owner parked it, without focus (see below), and the PNG path is in Windows form.
G="${GODOT:-godot}"
# The game uses the Mobile renderer (Vulkan on desktop, Metal on iPhone). Headless cloud boxes without
# a Vulkan driver render with OpenGL instead (no HDR bloom): SHOOT_DRIVER overrides.
if command -v cygpath >/dev/null 2>&1; then drv="${SHOOT_DRIVER:-vulkan}"; else drv="${SHOOT_DRIVER:-opengl3}"; fi
out_abs="$(realpath -m "$out")"
command -v cygpath >/dev/null 2>&1 && out_abs="$(cygpath -m "$out_abs")"
if command -v xvfb-run >/dev/null 2>&1 && command -v flock >/dev/null 2>&1; then
  # The lock wait is not limited (other agents may hold it); the render itself gets 120 s.
  log=$(flock /tmp/halo-godot.lock timeout 120 xvfb-run -a -s "-screen 0 1800x2400x24" \
    "$G" --path . --rendering-driver "$drv" --resolution "$res" -- \
    --shoot="$screen" --shoot-out="$out_abs" "${extra[@]}" 2>&1 | grep -vE "$NOISE")
else
  # Windows: the owner may be playing a game on the main monitor. The window opens where they parked
  # it (screenshots/.shot_window, from --place; by default on the left-hand monitor of the owner's
  # PC) and can't take focus. override.cfg is read before the window opens; removed afterwards.
  # SHOOT_VISIBLE=1 opens it the old way (centred, focused).
  if [ -z "${SHOOT_VISIBLE:-}" ] && [ ! -f override.cfg ]; then
    # Godot counts window positions from the top-left of the whole desktop (all monitors), not
    # from the main monitor: on the owner's PC the left monitor is x 0-1920 there.
    pos=$(cat screenshots/.shot_window 2>/dev/null | tr -d '\r\n ')
    [ -n "$pos" ] || pos="60,120"
    focus=true; [ -n "$place" ] && focus=false
    printf '%s\n' '[display]' '' "window/size/no_focus=$focus" 'window/size/initial_position_type=0' \
      "window/size/initial_position=Vector2i($pos)" > override.cfg
    trap 'rm -f override.cfg' EXIT
  fi
  if [ -n "$place" ]; then
    extra+=("--shoot-place=$place" "--shoot-place-file=$(cygpath -m "$(realpath -m screenshots/.shot_window)")")
  fi
  log=$(timeout 120 "$G" --path . --rendering-driver "$drv" --resolution "$res" -- \
    --shoot="$screen" --shoot-out="$out_abs" "${extra[@]}" 2>&1 | grep -vE "$NOISE")
fi
echo "$log" | grep -E -A2 "SCRIPT ERROR|Parse Error|ERROR:" | head -30
[ -f "$out" ] && echo "PNG: $out" || { echo "NO PNG WRITTEN"; echo "$log" | tail -15; exit 1; }
